# Install as /etc/vogelvrij/test.env with owner root:root and mode 0600.
# Use this one file for Compose --env-file and both systemd services.
# Replace every placeholder through the CD secret store; do not commit real values.
POSTGRES_DB=vogelvrij_test
POSTGRES_USER=vogelvrij_test
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://vogelvrij_test:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5434/vogelvrij_test
GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_BROWSER_KEY
VOGELVRIJ_LAT=50.900167
VOGELVRIJ_LON=4.460000
VOGELVRIJ_RADIUS_NM=15
VOGELVRIJ_FLIGHT_INTERVAL=60
VOGELVRIJ_WEB_HOST=127.0.0.1
VOGELVRIJ_WEB_PORT=8767
