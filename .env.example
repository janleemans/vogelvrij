# Center of the area to monitor, in decimal degrees.
VOGELVRIJ_LAT=50.8503
VOGELVRIJ_LON=4.3517

# Radius around the center point, in nautical miles (maximum 250).
VOGELVRIJ_RADIUS_NM=25

# PostgreSQL connection used when persisting collection results.
DATABASE_URL=postgresql+psycopg://vogelvrij:vogelvrij@localhost:5433/vogelvrij

# Local Docker database settings. Use different secrets outside local development.
POSTGRES_DB=vogelvrij
POSTGRES_USER=vogelvrij
POSTGRES_PASSWORD=vogelvrij
POSTGRES_PORT=5433

# Only needed to generate a local Google Maps page. Do not commit the actual key.
GOOGLE_MAPS_API_KEY=REPLACE_WITH_A_RESTRICTED_BROWSER_KEY
